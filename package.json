{
  "name": "providerlist",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "ProviderList.dev — 面向开发者的 AI Provider 当前供应与能力注册中心",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "pnpm build:catalog && pnpm build:frontend && pnpm build:release",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test && node --test scripts/*.test.mjs scripts/ci/*.test.mjs",
    "lint": "pnpm typecheck && node scripts/secret-scan.mjs .",
    "scan:secrets": "node scripts/secret-scan.mjs .",
    "licenses:generate": "node scripts/licenses/generate-licenses.mjs",
    "licenses:check": "node scripts/licenses/check-licenses.mjs",
    "check:page-links": "node scripts/ci/check-page-links.mjs",
    "validate:data": "pnpm --filter @providerlist/pipeline validate",
    "build:catalog": "pnpm --filter @providerlist/pipeline build",
    "ingest:sources": "pnpm --filter @providerlist/pipeline ingest:sources",
    "ingest:source": "pnpm --filter @providerlist/pipeline ingest:source",
    "ingest:feed-discovery": "pnpm --filter @providerlist/pipeline ingest:feed-discovery",
    "ingest:minimax": "pnpm --filter @providerlist/pipeline ingest:minimax",
    "ingest:minimax:merge": "pnpm --filter @providerlist/pipeline ingest:minimax:merge",
    "ingest:zhipu": "pnpm --filter @providerlist/pipeline ingest:zhipu",
    "ingest:zhipu:merge": "pnpm --filter @providerlist/pipeline ingest:zhipu:merge",
    "ingest:moonshotai": "pnpm --filter @providerlist/pipeline ingest:moonshotai",
    "ingest:stepfun": "pnpm --filter @providerlist/pipeline ingest:stepfun",
    "ingest:deepseek": "pnpm --filter @providerlist/pipeline ingest:deepseek",
    "ingest:alibaba": "pnpm --filter @providerlist/pipeline ingest:alibaba",
    "ingest:volcengine": "pnpm --filter @providerlist/pipeline ingest:volcengine",
    "ingest:volcengine:global": "pnpm --filter @providerlist/pipeline ingest:volcengine:global",
    "ingest:tencent": "pnpm --filter @providerlist/pipeline ingest:tencent",
    "ingest:xiaomi": "pnpm --filter @providerlist/pipeline ingest:xiaomi",
    "ingest:bailing": "pnpm --filter @providerlist/pipeline ingest:bailing",
    "ingest:openai": "pnpm --filter @providerlist/pipeline ingest:openai",
    "ingest:openai:merge": "pnpm --filter @providerlist/pipeline ingest:openai:merge",
    "ingest:google": "pnpm --filter @providerlist/pipeline ingest:google",
    "ingest:xai": "pnpm --filter @providerlist/pipeline ingest:xai",
    "ingest:meta": "pnpm --filter @providerlist/pipeline ingest:meta",
    "ingest:sync": "pnpm --filter @providerlist/pipeline ingest:sync",
    "ingest:global-merges": "pnpm --filter @providerlist/pipeline ingest:global-merges",
    "ingest:moonshotai:merge": "pnpm --filter @providerlist/pipeline ingest:moonshotai:merge",
    "ingest:stepfun:merge": "pnpm --filter @providerlist/pipeline ingest:stepfun:merge",
    "ingest:deepseek:merge": "pnpm --filter @providerlist/pipeline ingest:deepseek:merge",
    "ingest:alibaba:merge": "pnpm --filter @providerlist/pipeline ingest:alibaba:merge",
    "ingest:volcengine:merge": "pnpm --filter @providerlist/pipeline ingest:volcengine:merge",
    "ingest:volcengine:global-merge": "pnpm --filter @providerlist/pipeline ingest:volcengine:global-merge",
    "ingest:tencent:merge": "pnpm --filter @providerlist/pipeline ingest:tencent:merge",
    "ingest:xiaomi:merge": "pnpm --filter @providerlist/pipeline ingest:xiaomi:merge",
    "ingest:bailing:merge": "pnpm --filter @providerlist/pipeline ingest:bailing:merge",
    "ingest:decision": "pnpm --filter @providerlist/pipeline ingest:decision",
    "ingest:cleanup": "pnpm --filter @providerlist/pipeline ingest:cleanup",
    "build:frontend": "pnpm --filter @providerlist/frontend build",
    "build:release": "node scripts/build-release.mjs",
    "dev:frontend": "pnpm --filter @providerlist/frontend dev",
    "dev": "pnpm --filter @providerlist/frontend dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
