{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://providerlist.dev/schema/model-registry.schema.json",
  "title": "ProviderList Canonical Model Registry",
  "description": "全局规范模型身份与发布事实。",
  "type": "object",
  "required": [
    "schema_version",
    "data_version",
    "generated_at",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/Semver"
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "$ref": "#/$defs/IsoDateTime"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Model"
      }
    }
  },
  "$defs": {
    "Semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "ModelType": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ModelModalities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "ModelLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "input": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "output": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "ModelOutputDimensions": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "supported"
          ]
        },
        {
          "required": [
            "min",
            "max"
          ]
        }
      ],
      "dependentRequired": {
        "min": [
          "max"
        ],
        "max": [
          "min"
        ]
      },
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "default": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ModelSpecifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image_output_resolutions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "video_output_resolutions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "video_duration_seconds": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "audio_duration_seconds": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "Model": {
      "type": "object",
      "required": [
        "id",
        "developer_id",
        "developer_name",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "developer_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "developer_name": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/ModelType"
        },
        "modalities": {
          "$ref": "#/$defs/ModelModalities"
        },
        "limits": {
          "$ref": "#/$defs/ModelLimits"
        },
        "output_dimensions": {
          "$ref": "#/$defs/ModelOutputDimensions"
        },
        "specifications": {
          "$ref": "#/$defs/ModelSpecifications"
        },
        "capabilities": {
          "$ref": "#/$defs/ModelCapabilities"
        },
        "release_date": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        }
      }
    },
    "ModelCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reasoning": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "tool_calling": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "structured_output": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "temperature": {
          "$ref": "#/$defs/CapabilityControl"
        },
        "top_p": {
          "$ref": "#/$defs/CapabilityControl"
        },
        "top_k": {
          "$ref": "#/$defs/CapabilityControl"
        }
      }
    },
    "CapabilityControl": {
      "oneOf": [
        {
          "type": [
            "boolean",
            "null"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
