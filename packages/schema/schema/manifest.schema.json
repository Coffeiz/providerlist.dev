{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://providerlist.dev/schema/manifest.schema.json",
  "title": "ProviderList Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_version",
    "generated_at",
    "catalog_status",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "catalog_status": {
      "enum": [
        "published",
        "draft"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileEntry"
      }
    },
    "source_revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "FileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
