{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://providerlist.dev/schema/fx-reference.schema.json",
  "title": "ProviderList FX Reference Document",
  "description": "参考汇率快照（派生层）。关键约束：这是派生视图，官方价格记录的原币种与原值永不因它改变；as_of_date 是来源公布日，不是抓取日也不是「今天」；参考汇率不是结算汇率，不得用于结算、税务或财务承诺。",
  "type": "object",
  "required": [
    "schema_version",
    "data_version",
    "generated_at",
    "fx_reference"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "$ref": "#/$defs/IsoDateTime"
    },
    "fx_reference": {
      "$ref": "#/$defs/FxReference"
    }
  },
  "$defs": {
    "IsoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "CurrencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 三字母代码。人民币是 CNY，不是 RMB。"
    },
    "DecimalString": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "十进制字符串，禁止 JSON number——二进制浮点做计费计算会算错钱。"
    },
    "FxQuote": {
      "type": "object",
      "required": [
        "currency",
        "rate_decimal"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "rate_decimal": {
          "$ref": "#/$defs/DecimalString",
          "description": "1 基准 = rate_decimal 报价币。方向由 base 决定，不写成裸比值。"
        }
      }
    },
    "FxSource": {
      "type": "object",
      "required": [
        "publisher",
        "dataset",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "description": "精确取数 URL，不是首页链接。"
        },
        "reference_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "对应设计文档的参考条目编号，如 R6。"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "原始响应内容哈希，用于事后核对抓取来源。"
        }
      }
    },
    "FxDerivation": {
      "type": "object",
      "required": [
        "formula",
        "pairs"
      ],
      "additionalProperties": false,
      "properties": {
        "formula": {
          "type": "string",
          "minLength": 1,
          "description": "人类可读公式，基准与方向必须能被第三方复算。"
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "公式用到的原始币对，如 EUR/CNY、EUR/USD。"
        }
      }
    },
    "FxReference": {
      "type": "object",
      "required": [
        "id",
        "base",
        "quotes",
        "as_of_date",
        "retrieved_at",
        "source",
        "derivation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "$ref": "#/$defs/CurrencyCode",
          "description": "基准币种，如 EUR。quotes 里的每个 rate 都是相对它的报价。"
        },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/FxQuote"
          }
        },
        "as_of_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "来源公布日。休市日必须取最近一个有效参考汇率日期，并保留原日期。"
        },
        "retrieved_at": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "source": {
          "$ref": "#/$defs/FxSource"
        },
        "derivation": {
          "$ref": "#/$defs/FxDerivation"
        }
      }
    },
    "FxReferenceDocument": {
      "type": "object",
      "required": [
        "schema_version",
        "data_version",
        "generated_at",
        "fx_reference"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "data_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "fx_reference": {
          "$ref": "#/$defs/FxReference"
        }
      }
    }
  }
}
