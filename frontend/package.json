{
  "name": "@providerlist/frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "ProviderList 站点前端（Vue 3 + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node ../scripts/prerender-seo.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@providerlist/schema": "workspace:*",
    "@providerlist/shared": "workspace:*",
    "@remixicon/vue": "^4.9.0",
    "@tanstack/vue-virtual": "^3.13.48",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
